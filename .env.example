# Copy values into the host environment or wp-config.php.
# Do not commit real secrets.

# X Ads Conversion API (generate in X Ads Manager → Events → Manual setup).
X_PIXEL_TOKEN=

# Optional Stripe / Mapbox (also support SNF_* defines in wp-config.php)
# SNF_STRIPE_SECRET_KEY=
# SNF_MAPBOX_TOKEN=

# Nuxt hybrid bridge (also define in wp-config.php)
# SNF_NUXT_BRIDGE=true
# SNF_NUXT_APP_URL=http://localhost:3000
#
# Nuxt / WooNuxt app (frontend/.env) — see frontend/.env.example
# GQL_HOST=https://localhost/super-ninety-four/graphql
# NUXT_IMAGE_DOMAINS=localhost
# NUXT_PUBLIC_WP_URL=https://localhost/super-ninety-four
# NUXT_WP_URL=https://localhost/super-ninety-four

