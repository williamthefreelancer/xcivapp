# ─── WooNuxt (required) ─────────────────────────────────────
# WordPress GraphQL endpoint (Settings for WooNuxt + WPGraphQL)
GQL_HOST=https://localhost/super-ninety-four/graphql

# Hostnames only, comma-separated (no https://)
NUXT_IMAGE_DOMAINS=localhost

# Optional: storefront origin when different from GQL_HOST
APP_HOST=http://localhost:3000

# ISR cache lifetime for catalog routes (seconds)
CATALOG_ISR_TTL=3600

# Optional overrides (also configurable via WooNuxt Settings plugin)
# NUXT_PUBLIC_PRODUCTS_PER_PAGE=24
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
# PRIMARY_COLOR=#111111

# ─── SNF bridge (REST / Store API / theme) ───────────────────
# WordPress site URL (no trailing slash) — browser + Nitro /api/wp proxy
NUXT_PUBLIC_WP_URL=https://localhost/super-ninety-four
NUXT_WP_URL=https://localhost/super-ninety-four
