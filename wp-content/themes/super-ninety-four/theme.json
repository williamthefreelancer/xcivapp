{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#f3ebe8"
        },
        {
          "slug": "ink-muted",
          "name": "Ink muted",
          "color": "rgba(243, 235, 232, 0.72)"
        },
        {
          "slug": "ink-soft",
          "name": "Ink soft",
          "color": "rgba(243, 235, 232, 0.42)"
        },
        {
          "slug": "grad-top",
          "name": "Gradient top",
          "color": "#815B5A"
        },
        {
          "slug": "grad-bottom",
          "name": "Gradient bottom",
          "color": "#1B1313"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "rgba(27, 19, 19, 0.42)"
        },
        {
          "slug": "surface-strong",
          "name": "Surface strong",
          "color": "rgba(27, 19, 19, 0.72)"
        },
        {
          "slug": "surface-border",
          "name": "Surface border",
          "color": "rgba(243, 235, 232, 0.18)"
        }
      ],
      "gradients": [
        {
          "slug": "brand-vertical",
          "name": "Brand vertical",
          "gradient": "linear-gradient(180deg, #815B5A 0%, #1B1313 100%)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"League Gothic\", \"Arial Narrow\", Impact, sans-serif",
          "name": "League Gothic",
          "slug": "display"
        },
        {
          "fontFamily": "\"Open Sans\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "name": "Open Sans",
          "slug": "body"
        },
        {
          "fontFamily": "\"Lato\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "name": "Lato",
          "slug": "nav"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1400px"
    },
    "custom": {
      "snf": {
        "frame-w": "1400px",
        "header-offset": "clamp(5.75rem, 11vw, 7.5rem)",
        "pad-x": "clamp(1rem, 4vw, 3rem)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--grad-bottom)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "letterSpacing": "0.02em"
        },
        "color": {
          "text": "#ffffff"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "#ffffff"
          }
        }
      },
      "button": {
        "color": {
          "background": "transparent",
          "text": "var(--wp--preset--color--ink)"
        },
        "border": {
          "color": "var(--wp--preset--color--surface-border)",
          "style": "solid",
          "width": "1px",
          "radius": "2px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "apply-hub",
      "title": "Apply Hub",
      "postTypes": ["page"]
    },
    {
      "name": "about",
      "title": "About",
      "postTypes": ["page"]
    },
    {
      "name": "billing-details",
      "title": "Billing Details Hub",
      "postTypes": ["page"]
    },
    {
      "name": "blank-canvas",
      "title": "Blank Canvas",
      "postTypes": ["page"]
    },
    {
      "name": "funnel-offer",
      "title": "Funnel Offer",
      "postTypes": ["page"]
    },
    {
      "name": "expo-marketplace",
      "title": "Expo Marketplace",
      "postTypes": ["page"]
    },
    {
      "name": "home-page",
      "title": "Home",
      "postTypes": ["page"]
    },
    {
      "name": "legal",
      "title": "Legal",
      "postTypes": ["page"]
    },
    {
      "name": "member-login",
      "title": "Member Login Hub",
      "postTypes": ["page"]
    },
    {
      "name": "messages",
      "title": "Messages Hub",
      "postTypes": ["page"]
    },
    {
      "name": "community",
      "title": "Community Hub",
      "postTypes": ["page"]
    },
    {
      "name": "public-content",
      "title": "Public Content",
      "postTypes": ["page"]
    },
    {
      "name": "reciprocal-club",
      "title": "Reciprocal Club",
      "postTypes": ["page"]
    },
    {
      "name": "reciprocal-hub",
      "title": "Reciprocal Hub",
      "postTypes": ["page"]
    },
    {
      "name": "select-events",
      "title": "Select Events Listings",
      "postTypes": ["page"]
    },
    {
      "name": "under-consideration",
      "title": "Under Consideration",
      "postTypes": ["page"]
    },
    {
      "name": "videos-audio",
      "title": "Videos & Audio",
      "postTypes": ["page"]
    },
    {
      "name": "woocommerce-account",
      "title": "WooCommerce Account Shell",
      "postTypes": ["page"]
    },
    {
      "name": "woocommerce-cart",
      "title": "WooCommerce Cart Shell",
