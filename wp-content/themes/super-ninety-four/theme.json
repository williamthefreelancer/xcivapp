{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#f3ebe8"
        },
        {
          "slug": "ink-muted",
          "name": "Ink muted",
          "color": "rgba(243, 235, 232, 0.72)"
        },
        {
          "slug": "grad-top",
          "name": "Gradient top",
          "color": "#815B5A"
        },
        {
          "slug": "grad-bottom",
          "name": "Gradient bottom",
          "color": "#1B1313"
        },
        {
          "slug": "surface-border",
          "name": "Surface border",
          "color": "rgba(243, 235, 232, 0.18)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"League Gothic\", \"Arial Narrow\", Impact, sans-serif",
          "name": "League Gothic",
          "slug": "display"
        },
        {
          "fontFamily": "\"Open Sans\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "name": "Open Sans",
          "slug": "body"
        },
        {
          "fontFamily": "\"Lato\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "name": "Lato",
          "slug": "nav"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1400px"
    }
  },
  "styles": {
    "color": {
      "background": "#1B1313",
      "text": "#f3ebe8"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400"
        }
      },
      "link": {
        "color": {
          "text": "#f3ebe8"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "apply-hub",
      "title": "Apply Hub",
      "postTypes": ["page"]
    },
    {
      "name": "about",
      "title": "About",
      "postTypes": ["page"]
    },
    {
      "name": "billing-details",
      "title": "Billing Details Hub",
      "postTypes": ["page"]
    },
    {
      "name": "blank-canvas",
      "title": "Blank Canvas",
      "postTypes": ["page"]
    },
    {
      "name": "expo-marketplace",
      "title": "Expo Marketplace",
      "postTypes": ["page"]
    },
    {
      "name": "home-page",
      "title": "Home",
      "postTypes": ["page"]
    },
    {
      "name": "legal",
      "title": "Legal",
      "postTypes": ["page"]
    },
    {
      "name": "member-login",
      "title": "Member Login Hub",
      "postTypes": ["page"]
    },
    {
      "name": "messages",
      "title": "Messages Hub",
      "postTypes": ["page"]
    },
    {
      "name": "public-content",
      "title": "Public Content",
      "postTypes": ["page"]
    },
    {
      "name": "reciprocal-club",
      "title": "Reciprocal Club",
      "postTypes": ["page"]
    },
    {
      "name": "reciprocal-hub",
      "title": "Reciprocal Hub",
      "postTypes": ["page"]
    },
    {
      "name": "select-events",
      "title": "Select Events Listings",
      "postTypes": ["page"]
    },
