{
  "apiVersion": 3,
  "name": "snf/form-slot",
  "title": "SNF Form Slot",
  "category": "snf",
  "icon": "feedback",
  "description": "Styled wrapper for Contact or Newsletter form blocks.",
  "textdomain": "super-ninety-four",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "hint": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "width": true
      }
    }
  }
}
